# App
APP_NAME=GitBrain
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://gitbrain:gitbrain@localhost:5432/gitbrain

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — generate a real secret for anything beyond local dev: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Embeddings — consumed starting Phase 4/7
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Optional -- leave unset to skip vector search gracefully (lexical + graph search
# still work; see backend/README.md's Phase 7 section)
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_BATCH_SIZE=100

# Ingestion (Phase 4)
REPO_STORAGE_PATH=/data/repos
GIT_CLONE_TIMEOUT_SECONDS=300
GIT_ALLOWED_PROTOCOLS=http:https
